<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_surface"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@mipmap/ic_launcher_round"
            android:contentDescription="SpeakAlert icon" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SpeakAlert"
                android:textColor="#FF312E81"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/upcoming_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Upcoming reminders"
                android:textColor="#FF475569"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/upcoming_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="No upcoming reminders"
        android:textColor="#FF475569"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/upcoming_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/widget_item_surface"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/upcoming_title_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF1F2937"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/upcoming_time_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF475569"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/upcoming_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_item_surface"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/upcoming_title_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF1F2937"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/upcoming_time_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF475569"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/upcoming_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_item_surface"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/upcoming_title_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF1F2937"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/upcoming_time_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF475569"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/upcoming_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_item_surface"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/upcoming_title_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF1F2937"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/upcoming_time_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF475569"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
