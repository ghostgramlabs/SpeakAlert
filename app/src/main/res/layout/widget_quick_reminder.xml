<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_surface"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@mipmap/ic_launcher_round"
            android:contentDescription="SpeakAlert icon" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/quick_widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SpeakAlert"
                android:textColor="#FF312E81"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quick_widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Quick add"
                android:textColor="#FF475569"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/quick_widget_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Open Add Reminder instantly"
        android:textColor="#FF334155"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/quick_add_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/widget_action_button"
        android:drawableStart="@android:drawable/ic_input_add"
        android:drawablePadding="8dp"
        android:gravity="center"
        android:minHeight="48dp"
        android:text="Add Reminder"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
